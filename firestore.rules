rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    match /players/{playerId} {
      function ownsPlayer() {
        return request.auth != null && request.auth.uid == playerId;
      }

      function validPlayer(data) {
        return data.keys().hasAll(['playerId', 'playerName', 'team'])
          && data.keys().hasOnly(['playerId', 'playerName', 'team', 'score', 'updatedAt'])
          && data.playerId == playerId
          && data.playerName is string
          && data.playerName.size() > 0
          && data.playerName.size() <= 80
          && data.team is string
          && data.team.size() <= 40
          && (!('score' in data) || (
            data.score is int
            && data.score >= 0
            && data.score <= 100
          ))
          && (!('updatedAt' in data) || data.updatedAt is string);
      }

      allow read: if request.auth != null;
      allow create, update: if ownsPlayer() && validPlayer(request.resource.data);
      allow delete: if false;
    }

    match /quiz/{quizId}/players/{playerId} {
      function ownsQuizPlayer() {
        return request.auth != null && request.auth.uid == playerId;
      }

      function validQuizScore(data) {
        return data.keys().hasAll(['playerId', 'playerName', 'team', 'score', 'updatedAt'])
          && data.keys().hasOnly(['playerId', 'playerName', 'team', 'score', 'updatedAt'])
          && data.playerId == playerId
          && data.playerName is string
          && data.playerName.size() > 0
          && data.playerName.size() <= 80
          && data.team is string
          && data.team.size() <= 40
          && data.score is int
          && data.score >= 0
          && data.score <= 100
          && data.updatedAt is string;
      }

      allow read: if request.auth != null;
      allow create, update: if ownsQuizPlayer() && validQuizScore(request.resource.data);
      allow delete: if false;
    }

    match /codigos_acceso/{codeId} {
      allow get: if true;
      allow list: if false;
      allow create, delete: if false;
      allow update: if resource.data.usado == false
        && request.resource.data.usado == true
        && request.resource.data.sesionId is string
        && request.resource.data.experiencia in ['harry-potter', 'stranger-things', 'la-ultima-pieza']
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['usado', 'sesionId', 'experiencia'])
        && existsAfter(/databases/$(database)/documents/sesiones_juego/$(request.resource.data.sesionId))
        && getAfter(/databases/$(database)/documents/sesiones_juego/$(request.resource.data.sesionId)).data.codigoId == codeId
        && getAfter(/databases/$(database)/documents/sesiones_juego/$(request.resource.data.sesionId)).data.activa == true
        && getAfter(/databases/$(database)/documents/sesiones_juego/$(request.resource.data.sesionId)).data.experiencia == request.resource.data.experiencia
        && existsAfter(/databases/$(database)/documents/experiencias/$(request.resource.data.experiencia)/accesos/$(request.resource.data.sesionId));
    }

    match /sesiones_juego/{sessionId} {
      allow get: if true;
      allow list, update, delete: if false;
      allow create: if request.resource.data.keys().hasAll(['activa', 'expiresAt', 'codigoId', 'experiencia'])
        && request.resource.data.keys().hasOnly(['activa', 'expiresAt', 'codigoId', 'experiencia'])
        && request.resource.data.activa == true
        && request.resource.data.codigoId is string
        && request.resource.data.experiencia in ['harry-potter', 'stranger-things', 'la-ultima-pieza']
        && request.resource.data.expiresAt is timestamp
        && exists(/databases/$(database)/documents/codigos_acceso/$(request.resource.data.codigoId))
        && get(/databases/$(database)/documents/codigos_acceso/$(request.resource.data.codigoId)).data.usado == false
        && getAfter(/databases/$(database)/documents/codigos_acceso/$(request.resource.data.codigoId)).data.usado == true
        && getAfter(/databases/$(database)/documents/codigos_acceso/$(request.resource.data.codigoId)).data.sesionId == sessionId
        && getAfter(/databases/$(database)/documents/codigos_acceso/$(request.resource.data.codigoId)).data.experiencia == request.resource.data.experiencia
        && get(/databases/$(database)/documents/codigos_acceso/$(request.resource.data.codigoId)).data.duracionHoras is int
        && get(/databases/$(database)/documents/codigos_acceso/$(request.resource.data.codigoId)).data.duracionHoras > 0
        && get(/databases/$(database)/documents/codigos_acceso/$(request.resource.data.codigoId)).data.duracionHoras <= 720
        && existsAfter(/databases/$(database)/documents/experiencias/$(request.resource.data.experiencia)/accesos/$(sessionId))
        && request.resource.data.expiresAt > request.time
        // Allow small client/server clock skew while keeping the code duration bounded.
        && request.resource.data.expiresAt
          <= request.time + duration.value(
            get(/databases/$(database)/documents/codigos_acceso/$(request.resource.data.codigoId)).data.duracionHoras,
            'h'
          ) + duration.value(5, 'm');
    }

    match /experiencias/{experienceId}/accesos/{sessionId} {
      allow get, list, update, delete: if false;
      allow create: if experienceId in ['harry-potter', 'stranger-things', 'la-ultima-pieza']
        && request.resource.data.keys().hasAll(['codigoId', 'createdAt', 'expiresAt'])
        && request.resource.data.keys().hasOnly(['codigoId', 'createdAt', 'expiresAt'])
        && request.resource.data.codigoId is string
        && request.resource.data.createdAt == request.time
        && request.resource.data.expiresAt is timestamp
        && existsAfter(/databases/$(database)/documents/sesiones_juego/$(sessionId))
        && getAfter(/databases/$(database)/documents/sesiones_juego/$(sessionId)).data.activa == true
        && getAfter(/databases/$(database)/documents/sesiones_juego/$(sessionId)).data.codigoId == request.resource.data.codigoId
        && getAfter(/databases/$(database)/documents/sesiones_juego/$(sessionId)).data.experiencia == experienceId
        && getAfter(/databases/$(database)/documents/sesiones_juego/$(sessionId)).data.expiresAt == request.resource.data.expiresAt
        && existsAfter(/databases/$(database)/documents/codigos_acceso/$(request.resource.data.codigoId))
        && getAfter(/databases/$(database)/documents/codigos_acceso/$(request.resource.data.codigoId)).data.usado == true
        && getAfter(/databases/$(database)/documents/codigos_acceso/$(request.resource.data.codigoId)).data.sesionId == sessionId
        && getAfter(/databases/$(database)/documents/codigos_acceso/$(request.resource.data.codigoId)).data.experiencia == experienceId;
    }
  }
}
